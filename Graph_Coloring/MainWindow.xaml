<Window x:Class="Graph_Coloring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розфарбовування графів" Height="550" Width="650" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Canvas x:Name="GraphCanvas" Background="Transparent" Grid.Column="0" MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"/>

        <StackPanel Grid.Column="1" Background="#E1E2E1">
            <TextBlock Text="КЕРУВАННЯ" FontWeight="Bold" TextAlignment="Center" Margin="0,15,0,15"/>

            <Button Content="Очистити граф" Margin="10,5" Padding="5" Click="BtnClear_Click"/>
            <Button Content="Hill Climbing" Margin="10,5" Padding="5" Click="BtnSolveHill_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="Simulated Annealing" Margin="10,5" Padding="5" Click="BtnSolveAnnealing_Click" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
            <Button Content="Beam Search" Margin="10,5" Padding="5" Click="BtnSolveBeam_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            
            <TextBlock Text="КІЛЬКІСТЬ КОЛЬОРІВ:" FontWeight="Bold" TextAlignment="Center" Margin="0,15,0,5"/>
            <TextBox x:Name="ColorCountInput" Text="0" Margin="10,0" Padding="5" TextAlignment="Center" FontSize="14" FontWeight="Bold"/>
            
            <Border BorderBrush="Gray" BorderThickness="1" Margin="10,20,10,10" Padding="10" Background="White">
                <TextBlock x:Name="ResultTextBlock" 
                           Text="Результати з'являться тут..." 
                           TextWrapping="Wrap" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#333333"/>
            </Border>

            <Button Content="💾 Зберегти звіт у файл" Margin="10,20,10,10" Padding="8" Click="BtnSaveFile_Click" Background="#455A64" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
